<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mikai.tap-endpoint</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/briancho/Library/Application Support/mikai/launchd/tap-endpoint-runner.sh</string>
    </array>

    <!-- Long-lived HTTP server. Launch at login and keep alive. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/briancho/.mikai/logs/tap-endpoint.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/briancho/.mikai/logs/tap-endpoint.err.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/briancho/Library/Application Support/mikai/launchd</string>
</dict>
</plist>
