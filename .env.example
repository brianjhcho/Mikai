# MIKAI environment variables
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# Graphiti sidecar — LLM for entity extraction and edge resolution
DEEPSEEK_API_KEY=sk-...

# Graphiti sidecar — embeddings (voyage-3, 1024-dim)
VOYAGE_API_KEY=pa-...

# Neo4j — graph database backing Graphiti
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mikai-local-dev

# Anthropic API — reserved for future Graphiti-native extraction or L4 inference
# ANTHROPIC_API_KEY=sk-ant-...

# MCP connector OAuth (D-048) — required for Claude.ai web and Claude mobile
# to add MIKAI as a Custom Connector. Leave MIKAI_OAUTH_ENABLED blank to keep
# the sidecar open (localhost-solo) or static-token mode.
#   MIKAI_OAUTH_PASSWORD — the operator password entered on the consent page;
#                          set a long random value, it is the only access gate.
#   MIKAI_OAUTH_ISSUER   — the public origin of the sidecar (Tailscale Funnel
#                          URL). Optional; derived from request headers if unset.
# MIKAI_OAUTH_ENABLED=1
# MIKAI_OAUTH_PASSWORD=
# MIKAI_OAUTH_ISSUER=https://your-node.ts.net
