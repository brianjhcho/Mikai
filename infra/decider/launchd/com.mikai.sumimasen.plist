<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mikai.sumimasen</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/briancho/Library/Application Support/mikai/launchd/sumimasen-runner.sh</string>
    </array>

    <!-- Every 5 minutes. Sumimasen fires at lead_min - window_min → lead_min
         before an event; default is 15-min lead with a 20-min window so we
         actually scan the window (now-5min → now+15min) and never miss a
         MIKAI-created block. -->
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>/Users/briancho/.mikai/logs/sumimasen.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/briancho/.mikai/logs/sumimasen.err.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/briancho/Library/Application Support/mikai/launchd</string>
</dict>
</plist>
