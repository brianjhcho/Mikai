<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mikai.dream-weekly</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/briancho/Library/Application Support/mikai/launchd/dream-weekly-runner.sh</string>
    </array>

    <!-- Sunday at 06:00 local — two hours before consolidate (Sunday
         08:00) so the weekly BRAIN.md consolidation reads an ontology
         rebuilt from the full current corpus. Nightly narrative is
         deliberately NOT scheduled (deferred pending use-case
         validation — see docs/DREAM_CRONS.md). -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>0</integer>
        <key>Hour</key><integer>6</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <!-- RunAtLoad=false: no surprise 15-min LLM burn on install/reboot;
         wait for the scheduled Sunday tick. -->
    <key>RunAtLoad</key>
    <false/>
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>/Users/briancho/.mikai/logs/dream-weekly.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/briancho/.mikai/logs/dream-weekly.err.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/briancho/Library/Application Support/mikai/launchd</string>
</dict>
</plist>
