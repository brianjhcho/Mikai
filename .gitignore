# Environment variables — never commit secrets
.env*
.env.local
# …but the example template carries no secrets and should be tracked
!.env.example
client_secret*.json

# macOS
.DS_Store
*.pem

# Python
__pycache__/
*.pyc
*.pyo
infra/graphiti/.venv/

# Node
/node_modules
/.pnp
.pnp.*

# Build artifacts
/out/
/build

# TypeScript
*.tsbuildinfo

# Testing
/coverage

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vercel
.vercel

# Supabase CLI temp files
supabase/.temp/

# Personal data exports — never commit conversation history or note data
sources/local-files/export/
sources/apple-notes/export/
sources/apple-notes/.synced.json
sources/local-files/.synced.json
sources/gmail/.synced.json
sources/imessage/.synced.json

# Eval results (generated artifacts)
engine/eval/results/*.json

# Scheduler logs
engine/scheduler/logs/

# Sync state files
scripts/.claude-code-synced.json
sources/apple-notes/.synced-direct.json

# Private strategy docs — local only, not for public repo
private/

# OMC internal state
.omc/
.claude/

# Superset / project session tool state
.superset/

# Eval harness output (per-run artifacts)
docs/evals/run-*.md

# Build cache
tsconfig.tsbuildinfo
sources/local-files/export/perplexity/
client_secret_*.json
package-lock.json

# Worktree parent artifact
.superset/

# Vendored nashsu — runtime + generated dirs (source tracked, deps not)
infra/nashsu/vendor/node_modules/
infra/nashsu/vendor/.llm-wiki/
infra/nashsu/vendor/**/*.upstream-backup
infra/nashsu/vendor/src-tauri/target/
# Explicitly track nashsu's package-lock.json (line 79 above ignores it globally)
!infra/nashsu/vendor/package-lock.json
