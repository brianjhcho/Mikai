<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mikai.dream-nightly</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/briancho/Library/Application Support/mikai/launchd/dream-nightly-runner.sh</string>
    </array>

    <!-- 03:00 local daily — incremental narrative delta (1 LLM call);
         Sundays the runner does a full-window rebuild instead, ahead of
         dream-weekly (06:00) and consolidate (08:00). See
         docs/DREAM_CRONS.md. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>3</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <!-- RunAtLoad=false: no surprise LLM burn on install/reboot; wait
         for the scheduled 03:00 tick. -->
    <key>RunAtLoad</key>
    <false/>
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>/Users/briancho/.mikai/logs/dream-nightly.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/briancho/.mikai/logs/dream-nightly.err.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/briancho/Library/Application Support/mikai/launchd</string>
</dict>
</plist>
